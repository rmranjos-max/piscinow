PISCINOW_DATABASE_URL=postgresql+psycopg://piscinow:piscinow@localhost:5432/piscinow
PISCINOW_LLM_PROVIDER=fake
PISCINOW_ANTHROPIC_API_KEY=
PISCINOW_OPENAI_API_KEY=
PISCINOW_SESSION_SECRET=change-me-in-production
PISCINOW_CHAT_RATE_LIMIT_PER_MINUTE=20
PISCINOW_PUBLIC_BASE_URL=http://localhost:8000
# development | production. Em production o app recusa subir com o segredo padrao
# e desliga pagar/liberar fase enquanto o provider de pagamento for simulacao.
PISCINOW_ENVIRONMENT=development
PISCINOW_ALLOW_PAYMENT_SIMULATION=false
# Duracao da sessao de login em segundos (padrao: 7 dias)
# PISCINOW_SESSION_MAX_AGE_SECONDS=604800
# Producao via docker compose (ver README): senha do Postgres e dominio do proxy
# POSTGRES_PASSWORD=
# PISCINOW_DOMAIN=localhost
# DEBUG | INFO | WARNING | ERROR
# PISCINOW_LOG_LEVEL=INFO
